# gdlint (gdtoolkit) config — run: pip install gdtoolkit && gdlint scripts/
max-line-length: 120
max-returns: 40
max-public-methods: 56
# creature.gd is the STATE MACHINE and nothing else: the mind, compass, heart,
# beliefs, bonds, foresight, steering, body, eyes, look and persistence are all
# their own files. What is left is thirty states and the motor code that drives
# them, and that is a fair size for it. This number is not moving again.
max-file-lines: 2500
