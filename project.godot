; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Hand of the Heavens (PoC)"
config/version="0.1.0-demo"
config/description="A ground-up, Black & White-inspired god game prototype: divine hand, needs-driven villagers, a trainable creature, belief, and gesture-cast miracles."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

GameState="*res://scripts/game_state.gd"
SoundBank="*res://scripts/audio/sound_bank.gd"
NavField="*res://scripts/nav_field.gd"
Quality="*res://scripts/quality.gd"
ModelBank="*res://scripts/model_bank.gd"
SaveGame="*res://scripts/save_game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
; Phones/tablets play in landscape, either way up.
window/handheld/orientation=4
; Scale the UI with the screen: a 900-line logical height everywhere, the
; width expanding to match the device's aspect (tall phones get more world,
; never stretched or letterboxed UI).
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

; Mobile renderer: looks good on a phone, needs no advanced GPU. MSAA is
; near-free on tiled mobile GPUs and smooths our primitive-shape world.
renderer/rendering_method="mobile"
; Both of these are OVERRIDDEN at boot from the detected graphics tier — see
; Quality.msaa_3d and Quality.render_scale, applied in Main._build_world. They
; are set to the MEDIUM tier's values here so the common device allocates its
; render targets once instead of allocating and then reallocating them. This
; said msaa_3d=2 (4x), which the game never actually ran at.
anti_aliasing/quality/msaa_3d=1
; The 3D pass renders at 85% of the panel and is upscaled. `canvas_items`
; stretch scales the UI only, so without this the world is drawn at every
; physical pixel — 2.6 million on an ordinary 1080p phone. Fragment cost goes
; with the square, so this is 72% of the shading and bandwidth for a blur our
; untextured, flat-coloured primitives have nothing to lose to.
scaling_3d/scale=0.85
